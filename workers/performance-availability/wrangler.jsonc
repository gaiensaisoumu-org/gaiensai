{
  "name": "gaiensai-performance-availability",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PERFORMANCE_AVAILABILITY",
        "class_name": "PerformanceAvailabilityDurableObject",
      },
      {
        "name": "APP_DATA_CACHE",
        "class_name": "AppDataCacheDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PerformanceAvailabilityDurableObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AppDataCacheDurableObject"],
    },
  ],
  "routes": [
    {
      "pattern": "api.gaiensai.com/performances-availability*",
      "zone_name": "gaiensai.com",
    },
    {
      "pattern": "api.gaiensai.com/app-data-cache*",
      "zone_name": "gaiensai.com",
    },
  ],

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
